<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Museums_TourGatheringSpot" or defName="Museums_Sign" or defName="Museums_DonationBox" or defName="Museums_DisplayCase_Medium" or defName="Museums_PedestalRectangular" or defName="Museums_PedestalCircular" or defName="Museums_PedestalHexagonal"]</xpath>
    <value>
      <researchPrerequisites>
        <li>Ferny_Museums</li>
      </researchPrerequisites>
    </value>
  </Operation>
  <!-- The barrier has its own list (Complex furniture) -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Museums_Barrier"]/researchPrerequisites</xpath>
    <value>
      <li>Ferny_Museums</li>
    </value>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Hospitality (Continued)</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>Defs/ThingDef[defName="Museums_DisplayCase_Small"]</xpath>
      <value>
        <researchPrerequisites>
          <li>Ferny_Museums</li>
        </researchPrerequisites>
      </value>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>ReBuild: Doors and Corners</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[@Name="Museums_GlassWall"]</xpath>
          <value>
            <researchPrerequisites>
              <li>Ferny_Museums</li>
            </researchPrerequisites>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Museums_GlassWall"]/label</xpath>
          <value>
            <label>observation glass wall</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Museums_GlassWall"]/costList</xpath>
          <value>
            <costList>
              <RB_Glass>5</RB_Glass>
            </costList>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Museums_ReinforcedGlassWall"]/label</xpath>
          <value>
            <label>reinforced observation glass wall</label>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>Defs/ThingDef[defName="Museums_ReinforcedGlassWall"]/costList</xpath>
          <value>
            <costList>
              <Steel>10</Steel>
              <RB_Glass>10</RB_Glass>
            </costList>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Roo's Painting Expansion</li>
    </mods>
    <match Class="PatchOperationAdd">
      <xpath>Defs</xpath>
      <value>
        <VEF.Buildings.HiddenDesignatorsDef>
          <defName>FernyMuseumsRoosPaintingProgHospitality_HiddenDesignators</defName>
          <hiddenDesignators>
            <li>RBPGalleryBarrier</li>
          </hiddenDesignators>
        </VEF.Buildings.HiddenDesignatorsDef>
      </value>
    </match>
  </Operation>
</Patch>
